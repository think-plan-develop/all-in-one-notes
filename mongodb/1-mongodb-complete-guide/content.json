      "heading": "MongoDB Terminology",
      "blocks": [
        {
          "type": "definitions",
          "items": [
            {
              "term": "Database",
              "definition": "Container that holds collections."
            },
            {
              "term": "Collection",
              "definition": "Group of MongoDB documents."
            },
            {
              "term": "Document",
              "definition": "JSON-like record stored in a collection."
            },
            {
              "term": "BSON",
              "definition": "Binary JSON format used internally by MongoDB."
            },
            {
              "term": "Index",
              "definition": "Data structure that improves query performance."
            },
            {
              "term": "Aggregation",
              "definition": "Framework used to process and transform data."
            }
          ]
        }
      ]
